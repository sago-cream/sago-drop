#!/usr/bin/env bun

import { mkdtemp, rm } from "node:fs/promises";
import { tmpdir } from "node:os";
import { basename, dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const root = resolve(dirname(fileURLToPath(import.meta.url)), "..");
const directory = await mkdtemp(join(tmpdir(), "sago-drop-jobs-smoke-"));
const jobs = new Map();
const uploads = new Map();
let prematureSuccess = false;
let slowStatusRequests = false;

const server = Bun.serve({
  hostname: "127.0.0.1", port: 0, idleTimeout: 30,
  async fetch(request) {
    const path = new URL(request.url).pathname;
    if (path.startsWith("/files/")) {
      const filename = decodeURIComponent(path.slice("/files/".length));
      const job = [...jobs.values()].find(job => job.filename === filename);
      return new Response(null, { status: job && Date.now() >= job.publicAt ? 200 : 404 });
    }
    const id = path.split("/").at(-1);
    if (request.method === "GET") {
      const started = Date.now();
      const job = jobs.get(id);
      if (!job) return new Response("Not found", { status: 404 });
      const ready = Date.now() >= job.readyAt;
      const status = ready ? (job.filename.includes("fail") ? "failed" : "ready") : "processing";
      const url = `${server.url}files/${encodeURIComponent(job.filename)}`;
      const result = Response.json({ id, status, result: status === "ready" ? { url, markdown: url, previewUrl: null } : undefined, error: status === "failed" ? "Mock processing failed" : undefined });
      if (Date.now() - started > 500) slowStatusRequests = true;
      return result;
    }
    if (request.method !== "POST" || path !== "/v1/upload-jobs") return new Response("Not found", { status: 404 });
    const filename = request.headers.get("x-media-filename");
    const key = request.headers.get("idempotency-key");
    uploads.set(filename, (uploads.get(filename) ?? 0) + 1);
    const hasher = new Bun.CryptoHasher("sha256");
    const reader = request.body.getReader();
    while (true) {
      const { done, value } = await reader.read();
      if (done) break;
      hasher.update(value);
      await Bun.sleep(20);
    }
    if (hasher.digest("hex") !== request.headers.get("x-media-sha256")) return new Response("Bad digest", { status: 422 });
    const readyAt = Date.now() + (filename.includes("delayed") ? 130_000 : 1500);
    jobs.set(key, { filename, readyAt, publicAt: readyAt + 500 });
    // Lose the acknowledgement after saving the file; the client must look up the same job.
    if (filename.includes("lost-ack")) return new Response("Temporary failure", { status: 503 });
    return Response.json({ id: key, status: "queued" }, { status: 202 });
  },
});

async function launch(file, pending) {
  const child = Bun.spawn([join(root, ".build/debug/SagoDrop")], {
    cwd: root, env: { ...Bun.env, MEDIA_URL: server.url.toString(), SAGO_MEDIA_SMOKE_FILE: file,
      SAGO_MEDIA_SMOKE_PENDING: pending, SAGO_MEDIA_SMOKE_LOG: "1", SAGO_MEDIA_SMOKE_TOKEN: "local-smoke-token" },
    stdout: "pipe", stderr: "pipe",
  });
  const output = Promise.all([new Response(child.stdout).text(), new Response(child.stderr).text()]).then(parts => parts.join("\n"));
  return { child, output };
}
async function scenario(name, filename, size, success, restart = false) {
  const file = join(directory, filename);
  await Bun.write(file, new Uint8Array(size));
  const pending = join(directory, `pending-${filename}`);
  const startedAt = Date.now();
  let { child, output } = await launch(file, pending);
  let watchdog = setTimeout(() => child.kill(), filename.includes("delayed") ? 155_000 : 25_000);
  if (restart) {
    const deadline = Date.now() + 15_000;
    while (![...jobs.values()].some(job => job.filename === filename)) {
      if (Date.now() > deadline) throw new Error("Upload was not accepted before restart");
      await Bun.sleep(50);
    }
    child.kill("SIGKILL"); await child.exited;
    const before = await output;
    if (before.includes("SMOKE state=success")) throw new Error("Premature checkmark before restart");
    clearTimeout(watchdog);
    ({ child, output } = await launch(file, pending));
    watchdog = setTimeout(() => child.kill(), 25_000);
  }
  const code = await child.exited;
  const log = await output;
  clearTimeout(watchdog);
  if (code !== 0) throw new Error(`${name}: app exited ${code}\n${log}`);
  for (const marker of ["SMOKE state=uploading", "actual=none finishing=true", `SMOKE state=${success ? "success" : "failure"}`, `SMOKE complete success=${success}`]) {
    if (!log.includes(marker)) throw new Error(`${name} missed ${marker}\n${log}`);
  }
  if (success) {
    const url = `${server.url}files/${encodeURIComponent(filename)}`;
    if (!log.includes(`SMOKE clipboard=${url}`) || log.indexOf("SMOKE clipboard=") > log.indexOf("SMOKE state=success")) throw new Error(`Checkmark appeared without the final clipboard URL\n${log}`);
    const job = [...jobs.values()].find(job => job.filename === filename);
    if (Date.now() < job.publicAt) prematureSuccess = true;
  } else if (log.includes("SMOKE state=success")) throw new Error("Failed processing showed a checkmark");
  if (uploads.get(filename) !== 1) throw new Error(`${name} uploaded ${uploads.get(filename)} times`);
  console.log(`PASS ${name} (${((Date.now() - startedAt) / 1000).toFixed(1)}s, one upload; checkmark follows clipboard and public availability)`);
}
try {
  const build = Bun.spawn(["swift", "build"], { cwd: root, stdout: "inherit", stderr: "inherit" });
  if (await build.exited !== 0) throw new Error("Build failed");
  await scenario("successful upload", "success.png", 12 * 1024 * 1024, true);
  await scenario("processing failure", "fail.png", 6 * 1024 * 1024, false);
  await scenario("lost acknowledgement recovery", "lost-ack.png", 64 * 1024, true);
  await scenario("app restart recovery", "restart.png", 64 * 1024, true, true);
  await scenario("processing beyond the proxy timeout", "delayed.png", 64 * 1024, true);
  if (prematureSuccess || slowStatusRequests) throw new Error("Completion or short-request contract violated");
} finally { server.stop(true); await rm(directory, { recursive: true, force: true }); }
